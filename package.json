{
  "name": "dsh-artex",
  "version": "0.15.0",
  "description": "ARTEX autonomous pentest platform as a DeepSeek Harness plugin: managed Docker sidecar, model tools, approval bridge, and the full ARTEX UI.",
  "license": "AGPL-3.0-or-later",
  "author": "Fengrru and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fengrru/dsh-artex.git"
  },
  "homepage": "https://github.com/Fengrru/dsh-artex#readme",
  "bugs": {
    "url": "https://github.com/Fengrru/dsh-artex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "docker",
    "skills",
    "patches",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "artex",
    "pentest",
    "penetration-testing",
    "security",
    "ai-agent",
    "automation"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm test && npm run build",
    "prepare": "npm run build"
  }
}
